{
  "name": "taskbrain",
  "version": "0.1.0",
  "description": "Agentic voice/text capture bot for Teams with an Azure second brain",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && npm run build:admin",
    "build:admin": "esbuild src/admin/client/graph.ts --bundle --minify --platform=browser --outfile=dist/admin/graph.js",
    "start": "node dist/index.js",
    "dev": "npm run build:admin && tsx watch src/index.ts",
    "test": "tsx --test --test-force-exit test/*.test.ts",
    "graph:backfill": "tsx scripts/backfill-graph.ts",
    "org:import": "tsx scripts/import-org.ts",
    "intent:evaluate": "tsx scripts/evaluate-intent.ts",
    "agent:evaluate": "tsx scripts/evaluate-agent.ts",
    "plaud:import-token": "tsx scripts/import-plaud-token.ts"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.1",
    "@azure/functions": "^4.16.5",
    "@azure/identity": "^4.13.3",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.24.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "botbuilder": "^4.23.1",
    "botframework-connector": "^4.23.1",
    "cron-parser": "^5.10.1",
    "cytoscape": "^3.34.3",
    "openai": "^7.17.0",
    "restify": "^12.0.0",
    "spectrum-ts": "^12.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/restify": "^8.5.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
