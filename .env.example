# Local development only. In Azure, EVERY setting below is written by infra/main.bicep
# on deploy — do not hand-edit App Service settings. bootstrap.sh patches this file.

# --- Bot identity (Entra app registration) ---
MicrosoftAppType=SingleTenant
MicrosoftAppId=00000000-0000-0000-0000-000000000000
MicrosoftAppPassword=
MicrosoftAppTenantId=00000000-0000-0000-0000-000000000000

# --- Azure AI Foundry (Azure OpenAI-compatible endpoint) ---
FOUNDRY_ENDPOINT=https://aif-taskbrain-xxxx.openai.azure.com
FOUNDRY_API_KEY=
CHAT_DEPLOYMENT=gpt-5            # or your Claude deployment name in Foundry
EMBED_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Speech ---
SPEECH_REGION=eastus
SPEECH_KEY=

# --- Second brain storage ---
STORAGE_CONNECTION_STRING=
NOTES_CONTAINER=notes
COSMOS_ENDPOINT=https://cos-taskbrain-xxxx.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DB=taskbrain

# --- Optional: Microsoft To Do via Graph (OAuth connection name on the Bot Service) ---
GRAPH_CONNECTION_NAME=graph-connection

PORT=3978

# --- Model routing (deployment names in Foundry per tier) ---
CHEAP_DEPLOYMENT=gpt-5-mini          # or Haiku-class — runs triage on every capture
STANDARD_DEPLOYMENT=gpt-5            # or Sonnet-class — tool-use agent loop
PREMIUM_DEPLOYMENT=gpt-5             # or Opus-class — digests/scheduled synthesis only

# --- MCP / external services ---
SMARTSHEET_API_TOKEN=                # bearer token for https://mcp.smartsheet.com

# --- Scheduler ---
JOBS_TIMEZONE=America/Chicago

# --- Admin dashboard (local only; Azure uses Entra Easy Auth) ---

# --- Alerts & budget ---
ADMIN_AAD_OBJECT_ID=                 # your Entra object id — receives admin alerts in Teams
DAILY_TOKEN_BUDGET=5000000           # tokens/day before auto-downgrade to cheap tier

# --- iMessage via Photon (spectrum-ts) — optional; leave blank to disable ---
SPECTRUM_PROJECT_ID=                 # from app.photon.codes project Settings
SPECTRUM_PROJECT_SECRET=
